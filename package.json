{
  "name": "move",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "pnpm --filter @workspace/move run dev",
    "build": "pnpm --filter @workspace/move run build",
    "typecheck": "pnpm --filter @workspace/move run typecheck",
    "test": "pnpm --filter @workspace/move run test",
    "check": "pnpm --filter @workspace/move run check"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
